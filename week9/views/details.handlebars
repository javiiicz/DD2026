<div class="row">
    <div class="col col-12 font-66">
        <h1><em><strong>{{destination.name}}</strong></em></h1>
    </div>

    <div class="col col-12">
        <img class="img-fluid wide-screen" src={{destination.image}} alt="{{destination.name}} image">
    </div>

    <div class="col col-12">
        <p class="fs-5">{{destination.description}}</p>
    </div>

    <div class="col col-12 d-flex flex-wrap gap-5">
        {{#each activities}}
        <div class="card mb-3 col col-4" style="width: 18rem;">
            <img src="/images/{{image}}" class="card-img-top img-fluid square">
            <div class="card-body">
                <h5 class="card-title">{{this.name}}</h5>
                <p class="card-text">{{this.description}}</p>
                <p>Cost: ${{this.cost}}</p>
                <a href="#" class="btn btn-primary">Go somewhere</a>
            </div>
        </div>
        {{/each}}
    </div>
</div>