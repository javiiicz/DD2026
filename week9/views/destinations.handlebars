<h1 class="font-64 funnel-display-bold">{{title}}</h1>
<div class="container">
    {{#each destinations}}

    <div class="row">
        <div class="col col-md-3">
            <h2 class="font-32 funnel-display-medium">{{this.name}}</h2>
            <img src={{this.image}} class="img-thumbnail img-fluid square" alt="{{this.name}} image">
        </div>
        <div class="col col-md-7 font-24 mt-5">
            <p>{{this.description}}</p>
        </div>
        <div class="col col-md-2 flex-column d-flex justify-content-center">
            <a href="/destinations/{{this._id}}" type="button" class="btn btn-info">View Details</a>
        </div>
    </div>

    {{/each}}
</div>